+
+  function tekenTooltip(ctx, hx, padBoven, W, regels, bgKleur, tekstKleur, lijnKleur) {
+    ctx.font = '600 12px system-ui, sans-serif';
+    let breedte = 0;
+    for (const r of regels) {
