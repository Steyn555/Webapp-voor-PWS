+    ctx.textAlign = 'left';
+    ctx.textBaseline = 'top';
+    regels.forEach((r, i) => {
+      ctx.fillText(r, bx + 9, by + 6 + i * 15);
+    });
+  }
+
+  function rondeRechthoek(ctx, x, y, w, h, r) {
+    ctx.beginPath();
+    ctx.moveTo(x + r, y);
+    ctx.arcTo(x + w, y, x + w, y + h, r);
+    ctx.arcTo(x + w, y + h, x, y + h, r);
+    ctx.arcTo(x, y + h, x, y, r);
+    ctx.arcTo(x, y, x + w, y, r);
+    ctx.closePath();
+  }
