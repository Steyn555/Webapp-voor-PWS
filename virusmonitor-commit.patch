+
+/* ---------- Tabbalk onderin (navigatie) ---------- */
+.tabbar {
+  position: absolute;
+  left: 12px;
+  right: 12px;
+  bottom: calc(34px + env(safe-area-inset-bottom, 0px));
+  z-index: 6;
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 2px;
+  padding: 5px;
+  background: var(--panel);
+  border: 1px solid var(--line);
+  border-radius: 18px;
+  box-shadow: 0 10px 28px rgba(0, 8, 48, 0.2);
+}
+
+.tab {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 3px;
+  min-height: 50px;
+  padding: 6px 2px 5px;
+  background: transparent;
+  border: 0;
+  border-radius: 13px;
+  color: var(--mute);
+  font-size: 0.66rem;
+  font-weight: 700;
+  letter-spacing: 0.01em;
+}
+
+.tab svg {
+  flex: none;
+}
+
+.tab:hover {
+  transform: none;
+  color: var(--accent);
+  background: var(--bg);
+}
+
+.tab.is-actief {
+  background: var(--accent);
+  color: #ffffff;
+}
+
+.tab:focus-visible {
+  outline: 3px solid var(--vaccin);
+  outline-offset: 2px;
+}
+
+/* ---------- Legenda op de kaart ---------- */
+.map-legend {
+  position: absolute;
+  right: 12px;
+  bottom: 28px;
+  z-index: 3;
+  display: flex;
+  flex-direction: column;
+  gap: 5px;
+  padding: 9px 11px;
+  background: rgba(255, 255, 255, 0.93);
+  border-radius: 11px;
+  box-shadow: 0 4px 14px rgba(0, 8, 48, 0.28);
+  pointer-events: none;
+}
+
+.map-legend-item {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  color: #0e1a36;
+  font-size: 0.68rem;
+  font-weight: 700;
+  white-space: nowrap;
+}
+
+.map-legend-item em {
+  font-style: normal;
+  font-weight: 600;
+  color: #3f4b66;
+}
+
+.map-legend-swatch {
+  flex: none;
+  width: 11px;
+  height: 11px;
+  border-radius: 3px;
+  box-shadow: inset 0 0 0 1px rgba(14, 26, 54, 0.28);
+}
+
+/* ---------- Menu-groep-labels ---------- */
+.menu-groep-label {
+  margin: 8px 2px -2px;
+  font-size: 0.66rem;
+  font-weight: 700;
+  letter-spacing: 0.09em;
+  text-transform: uppercase;
+  color: var(--mute);
+}
+
+/* ---------- Filterbalk en pillen ---------- */
+.filterbar {
+  display: flex;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: 10px;
+  margin: 0 0 14px;
+}
+
+.filter-select {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  margin: 0;
+  font-size: 0.74rem;
+  font-weight: 700;
+  color: var(--mute);
+}
+
+.filter-select select {
+  min-height: 42px;
+  padding: 8px 30px 8px 12px;
+  appearance: none;
+  -webkit-appearance: none;
+  background: var(--panel);
+  border: 1px solid var(--line);
+  border-radius: 10px;
+  color: var(--ink);
+  font: inherit;
+  font-weight: 600;
+  cursor: pointer;
+  background-image: linear-gradient(45deg, transparent 50%, var(--mute) 50%),
+    linear-gradient(135deg, var(--mute) 50%, transparent 50%);
+  background-position: calc(100% - 14px) 55%, calc(100% - 9px) 55%;
+  background-size: 5px 5px, 5px 5px;
+  background-repeat: no-repeat;
+}
+
+.pillgroup {
+  display: flex;
+  gap: 3px;
+  padding: 4px;
+  background: var(--panel);
+  border: 1px solid var(--line);
+  border-radius: 999px;
+}
+
+.pillgroup button {
+  min-height: 34px;
+  padding: 6px 12px;
+  background: transparent;
+  border: 0;
+  border-radius: 999px;
+  color: var(--mute);
+  font-size: 0.8rem;
+  font-weight: 700;
+}
+
+.pillgroup button:hover {
+  transform: none;
+  color: var(--accent);
+  box-shadow: none;
+}
+
+.pillgroup button.is-actief {
+  background: var(--accent);
+  color: #ffffff;
+}
+
+.pillgroup.breed {
+  width: 100%;
+  margin: 0 0 14px;
+}
+
+.pillgroup.breed button {
+  flex: 1;
+  padding: 6px 4px;
+  font-size: 0.76rem;
+}
+
+/* ---------- Statistiekaan: dashboard en voorspelling ---------- */
+.statgrid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 10px;
+  margin: 0 0 14px;
+}
+
+.statcard {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  gap: 3px;
+  padding: 12px 12px 11px;
+  background: var(--panel);
+  border: 1px solid var(--line);
+  border-top: 3px solid var(--pc, var(--accent));
+  border-radius: 14px;
+}
+
+.statcard-kop {
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  margin: 0 0 5px;
+  min-width: 0;
+}
+
+.statcard-icoon {
+  display: inline-grid;
+  place-items: center;
+  flex: none;
+  width: 26px;
+  height: 26px;
+  color: var(--pc, var(--accent));
+  background: var(--bg);
+  border-radius: 8px;
+}
+
+.statcard-label {
+  min-width: 0;
+  overflow-wrap: break-word;
+  font-size: 0.72rem;
+  font-weight: 700;
+  color: var(--mute);
+  line-height: 1.25;
+}
+
+.statcard-waarde {
+  font-size: 1.42rem;
+  font-weight: 800;
+  line-height: 1.1;
+  color: var(--ink);
+  font-variant-numeric: tabular-nums;
+  letter-spacing: -0.01em;
+}
+
+.statcard-sub {
+  font-size: 0.68rem;
+  color: var(--mute);
+}
+
+.delta {
+  display: inline;
+  margin-top: 5px;
+  font-size: 0.7rem;
+  font-weight: 700;
+  line-height: 1.35;
+}
+
+.delta svg {
+  margin-right: 3px;
+  vertical-align: -1.5px;
+}
+
+.delta.goed {
+  color: var(--gezond);
+}
+
+.delta.slecht {
+  color: var(--besmet);
+}
+
+.delta.neutraal {
+  color: var(--mute);
+  font-weight: 600;
+}
+
+/* ---------- Grafiekboxen ---------- */
+.page .box:not(.info) h2 {
+  margin: 0 0 2px;
+  font-size: 1.02rem;
+  color: var(--accent);
+}
+
+.chart-sub {
+  margin: 0 0 10px;
+  font-size: 0.76rem;
+  color: var(--mute);
+}
+
+#dash-chart,
+#vsp-chart {
+  width: 100%;
+  aspect-ratio: 16 / 9;
+  background: var(--bg);
+  border-radius: 10px;
+  touch-action: pan-y;
+}
+
+#vsp-chart {
+  aspect-ratio: 16 / 10;
+}
+
+/* ---------- Stijgers van deze week ---------- */
+.risers {
+  display: grid;
+  gap: 8px;
+}
+
+.riser {
+  display: grid;
+  grid-template-columns: auto minmax(0, 1fr) auto auto;
+  align-items: center;
+  gap: 10px;
+  min-height: 50px;
+  padding: 8px 12px;
+  text-align: left;
+  background: var(--panel);
+  border: 1px solid var(--line);
+  border-radius: 12px;
+}
+
+.riser:hover {
+  border-color: var(--besmet);
+  transform: translateY(-1px);
+}
+
+.riser-rang {
+  display: grid;
+  place-items: center;
+  width: 24px;
+  height: 24px;
+  background: var(--besmet);
+  color: #ffffff;
+  border-radius: 50%;
+  font-size: 0.76rem;
+  font-weight: 800;
+}
+
+.riser-naam {
+  font-weight: 700;
+  font-size: 0.9rem;
+  text-align: left;
+  color: var(--ink);
+}
+
+.riser-cijfer {
+  font-size: 0.76rem;
+  font-weight: 700;
+  color: var(--mute);
+  white-space: nowrap;
+}
+
+/* ---------- Demo-meldingen ---------- */
+.demo-note {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  margin: 14px 0 4px;
+  padding: 10px 12px;
+  background: var(--panel);
+  border: 1px dashed var(--line);
+  border-radius: 10px;
+  font-size: 0.76rem;
+  color: var(--mute);
+}
+
+.demo-note svg {
+  flex: none;
+  color: var(--accent);
+}
+
+.demo-banner {
+  display: flex;
+  align-items: flex-start;
+  gap: 10px;
+  margin: 0 0 14px;
+  padding: 12px 14px;
+  background: var(--panel);
+  border: 1px solid var(--besmet);
+  border-radius: 12px;
+  font-size: 0.84rem;
+  line-height: 1.45;
+}
+
+.demo-banner-icon {
+  flex: none;
+  color: var(--besmet);
+  margin-top: 1px;
+}
+
+.demo-banner p {
+  margin: 0;
+}
+
+/* ---------- Staafdiagrammen (DOM) ---------- */
+.bars {
+  display: grid;
+  gap: 7px;
+}
+
+.barrow {
+  display: grid;
+  grid-template-columns: 86px minmax(0, 1fr) 54px;
+  align-items: center;
+  gap: 8px;
+  font-size: 0.78rem;
+}
+
+.bars.week .barrow {
+  grid-template-columns: 56px minmax(0, 1fr) 44px;
+}
+
+.bars.age .barrow {
+  grid-template-columns: 62px minmax(0, 1fr) 44px;
+}
+
+.barlabel {
+  color: var(--mute);
+  font-weight: 700;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.bartrack {
+  position: relative;
+  height: 14px;
+  background: var(--bg);
+  border-radius: 999px;
+}
+
+.barfill {
+  height: 100%;
+  border-radius: 999px;
+  transition: width 0.45s ease;
+}
+
+.baravg {
+  position: absolute;
+  top: -2px;
+  bottom: -2px;
+  width: 0;
+  border-left: 2px dashed var(--ink);
+  opacity: 0.5;
+}
+
+.barvalue {
+  font-weight: 800;
+  text-align: right;
+  color: var(--ink);
+  font-variant-numeric: tabular-nums;
+  white-space: nowrap;
+}
+
+/* ---------- Gegevenstabel ---------- */
+.tablewrap {
+  overflow-x: auto;
+  margin: 0 -4px;
+  padding: 0 4px 2px;
+}
+
+.datatable {
+  width: 100%;
+  border-collapse: collapse;
+  font-size: 0.78rem;
+}
+
+.datatable th {
+  padding: 8px 8px;
+  background: var(--panel);
+  border-bottom: 2px solid var(--accent);
+  color: var(--accent);
+  font-size: 0.7rem;
+  font-weight: 800;
+  text-align: right;
+  white-space: nowrap;
+  cursor: pointer;
+  user-select: none;
+}
+
+.datatable th:first-child {
+  text-align: left;
+}
+
+.datatable th::after {
+  content: "\2195";
+  margin-left: 4px;
+  opacity: 0.3;
+  font-weight: 700;
+}
+
+.datatable th.sort-asc::after {
+  content: "\2191";
+  opacity: 1;
+}
+
+.datatable th.sort-desc::after {
+  content: "\2193";
+  opacity: 1;
+}
+
+.datatable th:focus-visible {
+  outline: 3px solid var(--vaccin);
+  outline-offset: 1px;
+}
+
+.datatable td {
+  padding: 7px 8px;
+  border-bottom: 1px solid var(--line);
+  font-variant-numeric: tabular-nums;
+  white-space: nowrap;
+}
+
+.datatable td.naam {
+  text-align: left;
+  font-weight: 700;
+}
+
+.datatable td.num {
+  text-align: right;
+}
+
+.datatable td small {
+  margin-left: 4px;
+  font-size: 0.66rem;
+  font-weight: 800;
+}
+
+.datatable td small.slecht {
+  color: var(--besmet);
+}
+
+.datatable td small.goed {
+  color: var(--gezond);
+}
+
+.datatable td small.neutraal {
+  color: var(--mute);
+}
+
+.datatable .rij-nl td {
+  background: var(--bg);
+  font-weight: 800;
+}
+
+.datatable .rij-nl td:first-child {
+  border-radius: 8px 0 0 8px;
+}
+
+.datatable .rij-nl td:last-child {
+  border-radius: 0 8px 8px 0;
+}
+
+/* ---------- Voorspelling ---------- */
+.voorspelling-conclusie {
+  margin: 12px 0 14px;
+  padding: 12px 14px;
+  background: var(--panel);
+  border-left: 4px solid var(--besmet);
+  border-radius: 10px;
+  font-size: 0.86rem;
+  line-height: 1.5;
+}
+
+.scenario-uitleg {
+  margin: 8px 2px 12px;
+}
+
+/* ---------- Minder beweging ---------- */
+@media (prefers-reduced-motion: reduce) {
+  .barfill {
+    transition: none;
+  }
+
+  .tab,
+  .pillgroup button,
+  .riser,
+  .statcard {
+    transition: none;
+  }
+}
