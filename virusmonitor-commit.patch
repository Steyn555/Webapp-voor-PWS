+      const W = rect.width;
+      const H = rect.height;
+      const padLinks = 38;
+      const padRechts = 12;
+      const padBoven = 14;
+      const padOnder = 22;
+      const plotB = W - padLinks - padRechts;
+      const plotH = H - padBoven - padOnder;
+
+      const n = cfg.labels.length;
+      const x = (i) => padLinks + (n <= 1 ? plotB / 2 : (i / (n - 1)) * plotB);
